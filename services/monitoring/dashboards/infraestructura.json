{
  "uid": "lago-infraestructura",
  "title": "Infraestructura · CPU, memoria y disco",
  "description": "node_exporter mide los recursos Linux visibles y el sistema de archivos de /datos.",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "title": "CPU por instancia",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lago-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$ventana])))",
          "legendFormat": "{{instance}}",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "lago-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sin muestras",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      }
    },
    {
      "title": "Memoria del ejecutor",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lago-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lago:memoria_usada:bytes",
          "legendFormat": "Usada",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "lago-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "Capacidad",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "lago-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "C",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Disponible",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "lago-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Sin muestras",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      }
    },
    {
      "title": "Capacidad disponible en /datos",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lago-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/datos\"}",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "lago-prom"
          },
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Sin muestras",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      }
    },
    {
      "title": "Ocupación de /datos",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lago-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/datos\"} / node_filesystem_size_bytes{mountpoint=\"/datos\"})",
          "legendFormat": "{{mountpoint}}",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "lago-prom"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sin muestras",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      }
    },
    {
      "title": "Máquinas virtuales de Proxmox",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lago-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pve_up{id=~\"qemu/.+\"}",
          "legendFormat": "{{id}}",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "lago-prom"
          },
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
