        "uid": "lago-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by(instance) (node_cpu_seconds_total{mode=\"idle\"})",
          "legendFormat": "{{instance}}",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "lago-prom"
          },
          "range": false,
          "instant": true,
