{
  "uid": "lago-kubernetes",
  "title": "Kubernetes · Nodos y disponibilidad",
  "description": "El acta RKE2 conserva el estado observado durante P5. Las series kube_* corresponden a una conexión en vivo a kube-state-metrics.",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "title": "Nodos Ready por fase · acta P5",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lago-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(fase) (lago_acta_nodo_condicion{condicion=\"True\"})",
          "legendFormat": "{{fase}}",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "lago-prom"
          },
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin muestras",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      }
    },
    {
      "title": "Última observación RKE2 · UTC",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "lago-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(lago_acta_rke2_fecha_segundos) * 1000",
          "legendFormat": "Última fase",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "lago-prom"
          },
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "Sin muestras",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      }
    },
    {
      "title": "Condición por nodo y fase · acta",
      "type": "table",
      "description": "Cada combinación de nodo, fase y condición procede de kubectl. El valor 1 señala la presencia de ese registro.",
      "datasource": {
        "type": "prometheus",
        "uid": "lago-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lago_acta_nodo_condicion",
          "legendFormat": "{{nodo}} {{fase}} {{condicion}}",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "lago-prom"
          },
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
